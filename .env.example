# Telegram API credentials from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# Telegram session file name (saved locally)
TG_SESSION=tg_bridge

# Telegram target (username or numeric ID)
TG_TARGET_USERNAME=some_user

# Delta Chat account credentials
DC_EMAIL=bot@example.org
DC_PASSWORD=super_secret

# IMAP
DC_IMAP_HOST=imap.example.org
DC_IMAP_PORT=993
DC_IMAP_SECURITY=ssl

# SMTP
DC_SMTP_HOST=smtp.example.org
DC_SMTP_PORT=465
DC_SMTP_SECURITY=ssl

# Delta Chat target mailbox
DC_TARGET_EMAIL=friend@example.org

# Optional: account data folder
DC_ACCOUNTS_DIR=./dc-accounts
